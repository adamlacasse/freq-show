# freq-show sample environment configuration
# Copy relevant values into the repository-root .env and adjust for local development.
# Keep KEY=value syntax; shell scripts load this format with `source`.

# Application environment identifier (development, staging, production, etc.).
APP_ENV=development

# Port the HTTP server listens on. PORT wins over HTTP_PORT when both are set.
PORT=8080
HTTP_PORT=

# Graceful shutdown timeout in seconds.
SHUTDOWN_TIMEOUT_SECONDS=10

# Database configuration (driver: sqlite or memory).
# DATABASE_URL is REQUIRED when DATABASE_DRIVER=sqlite — there is no default, so
# the server fails fast rather than creating an empty DB in its working dir.
# Use _pragma=foreign_keys(1), not _fk=1: the driver is modernc.org/sqlite, which
# silently ignores unrecognised query parameters like _fk.
# On Render, point this at the mounted disk: file:/var/data/freqshow.db?_pragma=foreign_keys(1)
DATABASE_DRIVER=sqlite
DATABASE_URL=file:freqshow.db?_pragma=foreign_keys(1)

# MusicBrainz API configuration. CONTACT should be a real email or URL per MusicBrainz terms.
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_APP_NAME=freq-show
MUSICBRAINZ_APP_VERSION=dev
MUSICBRAINZ_CONTACT=youremail@email.com
MUSICBRAINZ_TIMEOUT_SECONDS=6
MUSICBRAINZ_MIN_INTERVAL_MS=1100

# Wikipedia API configuration.
WIKIPEDIA_BASE_URL=https://en.wikipedia.org/api/rest_v1
WIKIPEDIA_USER_AGENT="FreqShow/1.0 (https://github.com/adamlacasse/freq-show)"
WIKIPEDIA_TIMEOUT_SECONDS=8

# Review provider configuration.
REVIEWS_USER_AGENT="FreqShow/1.0 (https://github.com/adamlacasse/freq-show)"
REVIEWS_TIMEOUT_SECONDS=10
REVIEWS_DISCOGS_TOKEN=
REVIEWS_DISCOGS_CONSUMER_KEY=
REVIEWS_DISCOGS_CONSUMER_SECRET=

# Discovery pipeline configuration (see ADR-0001).
# Embedding provider for the music discovery pipeline. One of: voyage (default), openai, huggingface.
DISCOVERY_EMBEDDINGS_PROVIDER=voyage
DISCOVERY_EMBEDDINGS_API_KEY=
# Optional model override; leave empty to use the provider's default.
DISCOVERY_EMBEDDINGS_MODEL=
# Optional provider API base URL override. Use https://ai.mongodb.com/v1 for MongoDB Atlas model API keys.
DISCOVERY_EMBEDDINGS_BASE_URL=
# LLM provider for query interpretation + curation. One of: huggingface (default), openai, anthropic.
DISCOVERY_LLM_PROVIDER=huggingface
DISCOVERY_LLM_API_KEY=
DISCOVERY_LLM_MODEL=
